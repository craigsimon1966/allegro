{
  "name": "allegro-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Allegro Learning teacher demo (see SPEC.md and TECH_SPEC.md)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"wrangler pages dev --port 8788\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:report": "tsx scripts/content-report.ts",
    "content:export-review": "tsx scripts/content-export-review.ts",
    "prompts:build": "tsx scripts/build-prompts.ts",
    "predev": "npm run prompts:build",
    "prebuild": "npm run prompts:build",
    "pretest": "npm run prompts:build",
    "security:dist": "tsx scripts/check-dist-secrets.ts",
    "size:dist": "tsx scripts/check-dist-size.ts",
    "content:approve": "tsx scripts/content-approve.ts",
    "content:import-review": "tsx scripts/content-import-review.ts",
    "curriculum:import": "NODE_USE_ENV_PROXY=1 tsx scripts/curriculum-import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.4",
    "katex": "0.16.47",
    "lucide-react": "1.79.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "6.30.6",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261124.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.7.0",
    "concurrently": "9.2.5",
    "docx": "9.15.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "fflate": "0.8.3",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wrangler": "4.167.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
