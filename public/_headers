# Cloudflare Pages response headers. Pages and the version file must never be served from a
# browser's cache, so a teacher always gets the latest build. Hashed assets never change.
# "! Cache-Control" drops the header inherited from /* before setting the path's own.
/*
  Cache-Control: no-cache
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/version.txt
  ! Cache-Control
  Cache-Control: no-store
